<div class="repo p-2">
  <a class="repo-card repo-profile-card" href="https://github.com/{{ include.username }}" rel="external nofollow noopener" target="_blank">
    <div class="repo-card-header">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      <span>{{ include.username }}</span>
    </div>
    <p>Research code, utilities, and BCI-related projects.</p>
    <div class="repo-tags" aria-label="GitHub profile topics">
      <span>GitHub profile</span>
      <span>Research code</span>
    </div>
  </a>
</div>
