{% assign repo_url = include.repository | split: '/' %}
{% assign repo_info = site.data.repositories.repo_metadata[include.repository] %}
{% assign repo_name = repo_url[1] | replace: '_', ' ' %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ include.repository }}" rel="external nofollow noopener" target="_blank">
    <div class="repo-card-header">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      <span>{{ repo_name }}</span>
    </div>
    <p>
      {% if repo_info.description %}
        {{ repo_info.description }}
      {% else %}
        GitHub repository by {{ repo_url[0] }}.
      {% endif %}
    </p>
    {% if repo_info.tags %}
      <div class="repo-tags" aria-label="Repository topics">
        {% for tag in repo_info.tags %}
          <span>{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </a>
</div>
